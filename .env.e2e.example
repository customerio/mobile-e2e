# Copy this file to .env.e2e.local. The local file is gitignored.
# Values already exported by your shell override this file.

# Shared Customer.io test-workspace API credentials.
MAESTRO_EXT_API_KEY=paste-app-api-key-here
# Optional; defaults to MAESTRO_EXT_API_KEY.
MAESTRO_APP_API_KEY=

# Published visual Inbox transactional message.
INBOX_TRANSACTIONAL_MESSAGE_ID=21

# Sample workspace values. When provided, the runner writes each SDK's
# gitignored sample configuration automatically before preflight/build.
ANDROID_CDP_API_KEY=
ANDROID_SITE_ID=
IOS_CDP_API_KEY=
IOS_SITE_ID=
E2E_WORKSPACE_NAME=Mobile E2E

# Native SDK clones used by cross-platform runs from this harness checkout.
ANDROID_SDK_REPO=/absolute/path/to/customerio-android
IOS_SDK_REPO=/absolute/path/to/customerio-ios

# Optional remote Live Activities configuration.
LIVE_ACTIVITY_APP_IDENTIFIER=
# The remote profile forces this on. Local runs leave it off because a clean
# Simulator is not guaranteed to obtain an Apple device token.
MAESTRO_LIVE_ACTIVITY_DEVICE_BACKEND_ENABLED=false
